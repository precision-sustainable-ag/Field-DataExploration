# Copy to scripts/dashboard.env and adjust. Read by run_dashboard.sh (hopper-os)
# and push_snapshot.sh (SUNNY). Keep dashboard.env out of git.

# hopper-os: where the snapshot lands, and the HTTPS port
FIELD_DASHBOARD_DATA=$HOME/field-dashboard-data
PORT=8501

# hopper-os, optional: Globus links on Browse. In the Globus website, open the
# field-batches folder, then copy from the browser's address bar:
#   origin_id=...    -> GLOBUS_COLLECTION_ID
#   origin_path=...  -> GLOBUS_FIELD_BATCHES_PATH   (as is; %2F is fine)
# With just those two, links open the cutout's folder. If the collection's page
# lists an "HTTPS URL", put it in GLOBUS_HTTPS_URL and links open the image itself.
GLOBUS_COLLECTION_ID=
GLOBUS_FIELD_BATCHES_PATH=
GLOBUS_HTTPS_URL=

# SUNNY: where push_snapshot.sh sends the snapshot
DASHBOARD_HOST=sbaghba@10.76.169.110
DASHBOARD_DIR=field-dashboard-data
