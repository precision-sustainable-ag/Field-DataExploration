# Copy to scripts/dashboard.env and adjust. Read by run_dashboard.sh (hopper-os)
# and push_snapshot.sh (SUNNY). Keep dashboard.env out of git.

# hopper-os: where the snapshot lands, and the HTTPS port
FIELD_DASHBOARD_DATA=$HOME/field-dashboard-data
PORT=8501

# hopper-os: Globus links on Browse (NC State Research Storage collection).
#   GLOBUS_COLLECTION_ID + GLOBUS_FIELD_BATCHES_PATH -> "Open folder" links (Globus file manager)
#   GLOBUS_HTTPS_URL + GLOBUS_FIELD_BATCHES_PATH      -> "View image" links (the file itself; Globus sign-in)
# The collection's "Domain" in the Globus website; the gaccess.io address is the one Globus is moving to.
GLOBUS_COLLECTION_ID=2f7f6170-8d5c-11e9-8e6a-029d279f7e24
GLOBUS_FIELD_BATCHES_PATH=/rsstu/users/r/raatwell/longterm_images3/field-batches
GLOBUS_HTTPS_URL=https://m-ae9b45.7ce1a.03c0.gaccess.io

# SUNNY: where push_snapshot.sh sends the snapshot
DASHBOARD_HOST=sbaghba@10.76.169.110
DASHBOARD_DIR=field-dashboard-data
